---
import { Image } from "astro:assets";

import heroImage from "@/assets/images/illustration-hero.svg";

import ContentWidthWrapper from "@/components/ui/content-width-wrapper.astro";
import Link from "@/components/ui/link.astro";
---

<section>
    <ContentWidthWrapper>
        <div class="flex flex-col-reverse xl:grid xl:grid-cols-2">
            <div class="px-5 py-10">
                <h1 class="font-medium text-center leading-10 text-3xl text-blue-950 tracking-wide mb-4">A Simple Bookmark Manager</h1>
                <p class="text-center text-gray-400 leading-6 max-w-xs mx-auto mb-6">
                    A clean and simple interface to organize your favourite websites. Open a new browser tab and see your sites load instantly. Try it for free.
                </p>

                <div class="flex gap-4 justify-center flex-wrap">
                    <Link variant="primary" href="/">
                        Get it on Chrome
                    </Link>
                    <Link variant="secondary" href="/">
                        Get it on Firefox
                    </Link>
                </div>
            </div>

            <div class="relative flex justify-center after:content-[''] after:absolute after:right-0 after:bottom-0 after:bg-blue-600 after:h-[75%] after:w-[calc(100vw-40px)] after:-z-10 after:rounded-[10em_0_0_10em] mt-15">
                <Image src={heroImage} alt="" class="w-full h-auto max-w-md" />
            </div>
        </div>
    </ContentWidthWrapper>
</section>
